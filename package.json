{
  "name": "nexlan",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "局域网文件传输与实时聊天工具",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theodoredv/Nexlan.git"
  },
  "bugs": {
    "url": "https://github.com/theodoredv/Nexlan/issues"
  },
  "homepage": "https://github.com/theodoredv/Nexlan#readme",
  "keywords": [
    "lan",
    "file-transfer",
    "chat",
    "express",
    "react",
    "typescript"
  ],
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "NODE_ENV=production tsx api/server.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.1",
    "fluent-ffmpeg": "2.1.3",
    "http-proxy-middleware": "3.0.5",
    "lucide-react": "0.511.0",
    "multer": "1.4.5-lts.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "spark-md5": "3.0.2",
    "tsx": "4.21.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/fluent-ffmpeg": "2.1.28",
    "@types/multer": "1.4.13",
    "@types/node": "22.19.17",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/spark-md5": "3.0.5",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "babel-plugin-react-dev-locator": "1.0.6",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "nodemon": "3.1.14",
    "postcss": "8.5.9",
    "supertest": "7.1.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.58.1",
    "vite": "6.4.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
